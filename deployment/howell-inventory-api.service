[Unit]
Description=Howell Inventory shared SQLite API
After=network.target

[Service]
Type=simple
User=howell-inventory
Group=howell-inventory
WorkingDirectory=/opt/howell-inventory
EnvironmentFile=/etc/howell-inventory/inventory.env
ExecStart=/usr/local/bin/node /opt/howell-inventory/server.cjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/howell-inventory
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
