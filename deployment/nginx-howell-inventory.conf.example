# Install after inventory.howellcable.site DNS points to this VPS and TLS cert exists.
server {
    listen 80;
    listen [::]:80;
    server_name inventory.howellcable.site;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        auth_basic off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Warehouse portal uses a separate host, root and Basic Auth file. Both frontends
# proxy to the same private API/database; only the warehouse API credentials can
# retrieve the server-side allowlisted warehouse projection.
server {
    listen 80;
    listen [::]:80;
    server_name gudang.inventory.howellcable.site;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        auth_basic off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name gudang.inventory.howellcable.site;

    root /var/www/howell-inventory/release/warehouse;
    index index.html;
    client_max_body_size 12m;

    auth_basic "Howell Inventory Gudang";
    auth_basic_user_file /etc/nginx/howell-warehouse.htpasswd;

    ssl_certificate /etc/letsencrypt/live/inventory.howellcable.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inventory.howellcable.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "no-store" always;

    location /api/ {
        proxy_pass http://127.0.0.1:3103/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name inventory.howellcable.site;

    root /var/www/howell-inventory/release;
    index index.html;
    client_max_body_size 12m;

    # Keep the files and API behind the same password gate. Node validates the API credentials again.
    auth_basic "Howell Inventory";
    auth_basic_user_file /etc/nginx/howell-inventory.htpasswd;

    ssl_certificate /etc/letsencrypt/live/inventory.howellcable.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inventory.howellcable.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    location /api/ {
        proxy_pass http://127.0.0.1:3103/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
